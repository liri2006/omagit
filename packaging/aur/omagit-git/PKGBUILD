# Maintainer: Andras Munkacsi <devnull2006 at gmail dot com>

pkgname=omagit-git
_pkgname=omagit
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc='Omarchy-native git GUI built for tiling window managers (latest commit)'
arch=('x86_64' 'aarch64')
url='https://github.com/liri2006/omagit'
license=('MIT')
depends=(
  'git'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libstdc++'
  'qt6-base'
  'ttf-font-nerd'
)
makedepends=('git')
optdepends=(
  'openssh: ssh remotes and SSH key sign-in'
  'libsecret: remember sign-ins in the keyring'
  'github-cli: pick one of your GitHub repositories to clone'
  'nautilus-python: the "Open in Omagit" entry in Nautilus'
  'claude-code: write commit messages with Claude Code'
  'openai-codex: write commit messages with Codex'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!debug')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # v0.2.0-3-gabc1234 → 0.2.0.r3.gabc1234; before the first tag, r<count>.<hash>.
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd "$_pkgname"
  # no_screenshot_keys leaves out a test-only option that needs Qt's private API.
  qmake6 omagit.pro \
    CONFIG+=no_screenshot_keys \
    PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

check() {
  cd "$_pkgname"
  # Offscreen, with a throw-away config and runtime directory of their own.
  tests/run.sh
}

package() {
  cd "$_pkgname"
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
