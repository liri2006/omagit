pkgbase = omagit-git
	pkgdesc = Omarchy-native git GUI designed for tiling window managers (latest commit)
	pkgver = 0.9.0.r0.g5212037
	pkgrel = 1
	url = https://github.com/liri2006/omagit
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	depends = git
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libstdc++
	depends = qt6-base
	depends = qt6-svg
	depends = ttf-font-nerd
	optdepends = openssh: ssh remotes and SSH key sign-in
	optdepends = libsecret: remember sign-ins in the keyring
	optdepends = github-cli: pick one of your GitHub repositories to clone
	optdepends = nautilus-python: the "Open in Omagit" entry in Nautilus
	optdepends = claude-code: write commit messages with Claude Code
	optdepends = openai-codex: write commit messages with Codex
	provides = omagit
	conflicts = omagit
	options = !debug
	source = omagit::git+https://github.com/liri2006/omagit.git
